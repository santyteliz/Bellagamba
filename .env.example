# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://bellagamba.com

# --- Propiedades: "json" (demo) o "tokko" ---
PROPERTIES_SOURCE=json
# API key de Tokko Broker (SOLO servidor, nunca NEXT_PUBLIC_)
TOKKO_API_KEY=

# --- Revalidación ISR (POST /api/revalidate?secret=...) ---
REVALIDATE_SECRET=

# --- Formularios ---
# Sin RESEND_API_KEY los formularios funcionan en modo mock (se loguean en el servidor)
RESEND_API_KEY=
FORMS_TO_EMAIL=info@bellagamba.com
FORMS_FROM_EMAIL=Web Bellagamba <web@bellagamba.com>
# Webhook opcional al CRM (Hunter / Tokko): recibe el JSON de cada formulario
CRM_WEBHOOK_URL=

# --- Analytics (solo se cargan con consentimiento "Aceptar todas") ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Reseñas de Google (Places API) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
